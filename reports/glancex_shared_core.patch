diff --git a/glancex/_box.py b/glancex/_box.py
index 14752eb..e588c64 100644
--- a/glancex/_box.py
+++ b/glancex/_box.py
@@ -1,120 +1,3 @@
-"""Box primitive heads: presence gate + center-patch choice + 4 ordinal edge distributions (+ IoU-confidence head).
-
-All geometry is in normalized image coordinates [0,1] (resize-invariant). Visual token (i,j) of an image with
-grid (gh, gw) has center ((j+.5)/gw, (i+.5)/gh).
-Edge offsets for a chosen patch center (px,py):  left=px-x1, top=py-y1, right=x2-px, bottom=y2-py, each a
-distribution over K bins spanning [edge_lo, edge_hi].
-"""
-import math
-import torch
-import torch.nn as nn
-
-
-def mlp(i, h, o):
-    return nn.Sequential(nn.Linear(i, h), nn.GELU(), nn.Linear(h, o))
-
-
-def fourier(xy, n=16):
-    freqs = (2.0 ** torch.arange(n, device=xy.device, dtype=xy.dtype)) * math.pi
-    a = xy[..., None] * freqs  # [...,2,n]
-    return torch.cat([a.sin(), a.cos()], -1).flatten(-2)  # [..., 4n]
-
-
-def box_iou_giou(a, b):
-    """a,b: [...,4] xyxy. returns iou, giou."""
-    x1 = torch.maximum(a[..., 0], b[..., 0]); y1 = torch.maximum(a[..., 1], b[..., 1])
-    x2 = torch.minimum(a[..., 2], b[..., 2]); y2 = torch.minimum(a[..., 3], b[..., 3])
-    inter = (x2 - x1).clamp(min=0) * (y2 - y1).clamp(min=0)
-    area = lambda t: (t[..., 2] - t[..., 0]).clamp(min=0) * (t[..., 3] - t[..., 1]).clamp(min=0)
-    union = area(a) + area(b) - inter
-    iou = inter / union.clamp(min=1e-9)
-    cx1 = torch.minimum(a[..., 0], b[..., 0]); cy1 = torch.minimum(a[..., 1], b[..., 1])
-    cx2 = torch.maximum(a[..., 2], b[..., 2]); cy2 = torch.maximum(a[..., 3], b[..., 3])
-    c = ((cx2 - cx1) * (cy2 - cy1)).clamp(min=1e-9)
-    return iou, iou - (c - union) / c
-
-
-class BoxHeads(nn.Module):
-    def __init__(self, D, cfg):
-        super().__init__()
-        self.cfg = cfg
-        d, K = cfg.head_dim, cfg.edge_bins
-        self.K = K
-        self.q_norm = nn.LayerNorm(D)
-        self.v_norm = nn.LayerNorm(D)
-        self.presence = mlp(D, d, 1)
-        self.c_q = nn.Linear(D, d)
-        self.c_k = nn.Linear(D, d)
-        self.edge = mlp(2 * D + 64, 2 * d, 4 * K)
-        self.iou = mlp(2 * D + 64, d, 1)
-        self.register_buffer("bin_centers", torch.linspace(cfg.edge_lo, cfg.edge_hi, K), persistent=False)
-
-    # ---------------------------------------------------------------- utils
-    def patch_centers(self, gh, gw, device):
-        ii, jj = torch.meshgrid(torch.arange(gh, device=device), torch.arange(gw, device=device), indexing="ij")
-        return torch.stack([(jj.flatten() + 0.5) / gw, (ii.flatten() + 0.5) / gh], -1)  # [gh*gw, 2] (x,y)
-
-    def _edge_feats(self, hq, v_sel, pc):
-        return torch.cat([hq, v_sel, fourier(pc)], -1)
-
-    def edges_logits(self, hq, v_sel, pc):
-        return self.edge(self._edge_feats(hq, v_sel, pc)).view(-1, 4, self.K)
-
-    def expected_box(self, edge_logits, pc):
-        p = edge_logits.softmax(-1)
-        e = (p * self.bin_centers).sum(-1)  # [M,4]  l,t,r,b
-        return torch.stack([pc[:, 0] - e[:, 0], pc[:, 1] - e[:, 1], pc[:, 0] + e[:, 2], pc[:, 1] + e[:, 3]], -1)
-
-    # ---------------------------------------------------------------- forward
-    def forward(self, hq, vis, vis_valid, centers, q_img, sel_idx=None):
-        """hq:[M,D] question readout; vis:[B,N,D] visual tokens per image (padded); vis_valid:[B,N];
-        centers:[B,N,2] patch centers; q_img:[M] image index of each question.
-        sel_idx:[M] patch to condition edges on (training: sampled from target). Heads run in fp32."""
-        hq = self.q_norm(hq.float())
-        vis = self.v_norm(vis.float())
-        pres = self.presence(hq).squeeze(-1)
-        kv = self.c_k(vis)                                    # [B,N,d]
-        cl = torch.einsum("md,mnd->mn", self.c_q(hq), kv[q_img]) / math.sqrt(self.c_q.out_features)
-        valid = vis_valid[q_img]
-        cl = cl.masked_fill(~valid, -1e4)
-        pred_idx = cl.argmax(-1)
-        out = dict(presence_logit=pres, center_logits=cl, pred_idx=pred_idx)
-        v_pred, pc_pred = vis[q_img, pred_idx], centers[q_img, pred_idx]
-        el_pred = self.edges_logits(hq, v_pred, pc_pred)
-        out["edge_logits_pred"] = el_pred
-        out["box_pred"] = self.expected_box(el_pred, pc_pred)
-        out["iou_logit"] = self.iou(self._edge_feats(hq, v_pred, pc_pred)).squeeze(-1)
-        if sel_idx is not None:
-            v_sel, pc_sel = vis[q_img, sel_idx], centers[q_img, sel_idx]
-            el = self.edges_logits(hq, v_sel, pc_sel)
-            out.update(edge_logits=el, pc_sel=pc_sel, box_sel=self.expected_box(el, pc_sel))
-        return out
-
-
-# ---------------------------------------------------------------- targets / losses
-def center_target_box(box, centers, valid, grid_hw):
-    """GUI-Actor style: mass on every patch covered by the GT box, proportional to the covered area fraction."""
-    gh, gw = grid_hw[:, 0].float()[:, None], grid_hw[:, 1].float()[:, None]
-    hx, hy = 0.5 / gw, 0.5 / gh
-    ox = (torch.minimum(centers[..., 0] + hx, box[:, 2:3]) - torch.maximum(centers[..., 0] - hx, box[:, 0:1])).clamp(min=0)
-    oy = (torch.minimum(centers[..., 1] + hy, box[:, 3:4]) - torch.maximum(centers[..., 1] - hy, box[:, 1:2])).clamp(min=0)
-    t = (ox * oy).masked_fill(~valid, 0)
-    t = t / t.sum(-1, keepdim=True).clamp(min=1e-12)
-    return t
-
-
-
-def edge_targets(box, pc, cfg, K):
-    offs = torch.stack([pc[:, 0] - box[:, 0], pc[:, 1] - box[:, 1], box[:, 2] - pc[:, 0], box[:, 3] - pc[:, 1]], -1)
-    offs = offs.clamp(cfg.edge_lo, cfg.edge_hi)
-    bw = (cfg.edge_hi - cfg.edge_lo) / (K - 1)
-    centers = torch.linspace(cfg.edge_lo, cfg.edge_hi, K, device=box.device)
-    t = torch.exp(-0.5 * ((centers - offs[..., None]) / (cfg.edge_sigma_bins * bw)) ** 2)
-    return t / t.sum(-1, keepdim=True), offs
-
-
-def cramer(logits, target):
-    """Squared CDF L2 distance summed over bins, mean over (M,4)."""
-    cdf_p = logits.softmax(-1).cumsum(-1)
-    cdf_t = target.cumsum(-1)
-    return ((cdf_p - cdf_t) ** 2).sum(-1).mean()
+"""The Glance single-box primitive (presence gate, patch-centre softmax, edge distributions, IoU head), served by the
+shared Glance core (`glance_core.box`, = decision-vision `dv/model/heads.py`)."""
+from glance_core.box import BoxHeads, box_iou_giou, center_target_box, cramer, edge_targets, fourier, mlp  # noqa: F401
diff --git a/glancex/_layers.py b/glancex/_layers.py
index 8b4198c..42e7af3 100644
--- a/glancex/_layers.py
+++ b/glancex/_layers.py
@@ -1,110 +1,8 @@
 """Low-level layer kernels shared by every Glance-X direction.
 
-A *prefix* is a sequence computed once and shared; a *block* is a sequence that continues a prefix:
-  * Gated DeltaNet layers: a block starts from its prefix's final recurrent state and last (k-1) conv inputs, exactly
-    what a causal continuation would see, but not the other blocks.
-  * full-attention layers: a block attends to all valid prefix keys plus its own block (bidirectional inside the
-    block with mask "block_bidir", causal with "causal"). The prefix itself is plain causal.
-This equals running every (prefix + block) separately, with the prefix computed once.
+These are served by the shared Glance core (`glance_core.prefix`), the same code that Glance (decision-vision `dv/model/
+backbone.py`) runs, so a fix on either side reaches both. Semantics, unchanged:
+  * Gated DeltaNet layers: a block starts from its prefix's final recurrent state and last (k-1) conv inputs.
+  * full-attention layers: a block attends to all valid prefix keys plus its own block ("block_bidir" | "causal").
 """
-import torch
-import torch.nn.functional as F
-
-try:
-    from fla.ops.gated_delta_rule import chunk_gated_delta_rule as fla_chunk_gdr
-except Exception:  # pragma: no cover
-    fla_chunk_gdr = None
-
-
-def _gdr(q, k, v, g, beta, initial_state=None):
-    """Chunked gated delta rule; q,k:[B,T,Hk,Dk] v:[B,T,Hv,Dv] g,beta:[B,T,Hv]. Returns (o, final_state fp32)."""
-    if fla_chunk_gdr is not None:
-        return fla_chunk_gdr(q, k, v, g=g, beta=beta, initial_state=initial_state, output_final_state=True,
-                             use_qk_l2norm_in_kernel=True)
-    from transformers.models.qwen3_5.modeling_qwen3_5 import torch_chunk_gated_delta_rule
-    return torch_chunk_gated_delta_rule(q, k, v, g=g, beta=beta, initial_state=initial_state,
-                                        output_final_state=True, use_qk_l2norm_in_kernel=True)
-
-
-def _gdn_mix(m, x):
-    """Shared projections. x:[B,T,D] -> mixed_qkv [B,C,T], z, beta, g."""
-    B, T, _ = x.shape
-    mixed = m.in_proj_qkv(x).transpose(1, 2)
-    z = m.in_proj_z(x).reshape(B, T, -1, m.head_v_dim)
-    beta = m.in_proj_b(x).sigmoid()
-    g = -m.A_log.float().exp() * F.softplus(m.in_proj_a(x).float() + m.dt_bias)
-    return mixed, z, beta, g
-
-
-def _gdn_core(m, conv_out, z, beta, g, init):
-    B, _, T = conv_out.shape
-    conv_out = F.silu(conv_out).transpose(1, 2)
-    q, k, v = torch.split(conv_out, [m.key_dim, m.key_dim, m.value_dim], dim=-1)
-    q = q.reshape(B, T, -1, m.head_k_dim)
-    k = k.reshape(B, T, -1, m.head_k_dim)
-    v = v.reshape(B, T, -1, m.head_v_dim)
-    o, S = _gdr(q, k, v, g, beta, init)
-    o = m.norm(o.reshape(-1, m.head_v_dim), z.reshape(-1, m.head_v_dim)).reshape(B, T, -1)
-    return m.out_proj(o), S
-
-
-def gdn_forward(m, xp, xq, p_valid, q_img):
-    K = m.conv_kernel_size
-    w = m.conv1d.weight  # [C,1,K]
-    # ---- prefix (left padded; zero the pads so they leave the state untouched) ----
-    xp = xp * p_valid[..., None].to(xp.dtype)
-    mixed, z, beta, g = _gdn_mix(m, xp)
-    Lp = mixed.shape[-1]
-    conv = F.conv1d(mixed.to(w.dtype), w, m.conv1d.bias, padding=K - 1, groups=mixed.shape[1])[..., :Lp]
-    op, S = _gdn_core(m, conv, z, beta, g, None)
-    tail = mixed[:, :, Lp - (K - 1):]                      # last k-1 conv inputs of each prefix
-    # ---- question blocks: continue from the prefix state ----
-    mixed_q, zq, beta_q, g_q = _gdn_mix(m, xq)
-    mq = torch.cat([tail[q_img], mixed_q], dim=-1).to(w.dtype)
-    conv_q = F.conv1d(mq, w, m.conv1d.bias, padding=0, groups=mq.shape[1])  # -> exactly Tq outputs
-    oq, _ = _gdn_core(m, conv_q, zq, beta_q, g_q, S[q_img].contiguous())
-    return op, oq
-
-
-def _qkv(m, x, cos, sin):
-    from transformers.models.qwen3_5.modeling_qwen3_5 import apply_rotary_pos_emb
-    B, T, _ = x.shape
-    q, gate = torch.chunk(m.q_proj(x).view(B, T, -1, m.head_dim * 2), 2, dim=-1)
-    gate = gate.reshape(B, T, -1)
-    q = m.q_norm(q).transpose(1, 2)
-    k = m.k_norm(m.k_proj(x).view(B, T, -1, m.head_dim)).transpose(1, 2)
-    v = m.v_proj(x).view(B, T, -1, m.head_dim).transpose(1, 2)
-    q, k = apply_rotary_pos_emb(q, k, cos, sin)
-    return q, k, v, gate
-
-
-def attn_forward(m, xp, xq, rope_p, rope_q, mask_p, mask_q, q_img):
-    B, Lp, _ = xp.shape
-    M, Tq, _ = xq.shape
-    qp, kp, vp, gp = _qkv(m, xp, *rope_p)
-    op = F.scaled_dot_product_attention(qp, kp, vp, attn_mask=mask_p, scale=m.scaling, enable_gqa=True)
-    op = op.transpose(1, 2).reshape(B, Lp, -1) * torch.sigmoid(gp)
-    qq, kq, vq, gq = _qkv(m, xq, *rope_q)
-    k_all = torch.cat([kp[q_img], kq], dim=2)
-    v_all = torch.cat([vp[q_img], vq], dim=2)
-    oq = F.scaled_dot_product_attention(qq, k_all, v_all, attn_mask=mask_q, scale=m.scaling, enable_gqa=True)
-    oq = oq.transpose(1, 2).reshape(M, Tq, -1) * torch.sigmoid(gq)
-    return m.o_proj(op), m.o_proj(oq)
-
-
-def build_masks(p_valid, q_valid, q_img, mode):
-    """Boolean SDPA masks (True = may attend)."""
-    B, Lp = p_valid.shape
-    M, Tq = q_valid.shape
-    dev = p_valid.device
-    causal = torch.ones(Lp, Lp, dtype=torch.bool, device=dev).tril()
-    eye_p = torch.eye(Lp, dtype=torch.bool, device=dev)
-    mask_p = (causal[None] & p_valid[:, None, :]) | eye_p[None]          # pads attend to themselves (no NaN)
-    if mode == "block_bidir":
-        within = q_valid[:, None, :].expand(M, Tq, Tq)
-    else:
-        within = torch.ones(Tq, Tq, dtype=torch.bool, device=dev).tril()[None] & q_valid[:, None, :]
-    within = within | torch.eye(Tq, dtype=torch.bool, device=dev)[None]
-    to_prefix = p_valid[q_img][:, None, :].expand(M, Tq, Lp)
-    mask_q = torch.cat([to_prefix, within], dim=-1)
-    return mask_p[:, None], mask_q[:, None]
+from glance_core.prefix import _gdn_core, _gdn_mix, _gdr, _qkv, attn_forward, build_masks, gdn_forward  # noqa: F401
